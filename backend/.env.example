# Copy to .env for local development. Never commit .env.

# --- OpenAI (required) ---
OPENAI_API_KEY=
# Use a standard (non-reasoning) chat model so the output token budget is not consumed by reasoning.
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT=30
OPENAI_MAX_OUTPUT_TOKENS=600
OPENAI_EMBEDDING_BATCH_SIZE=64
OPENAI_MAX_RETRIES=2
# Must match the pgvector column (1536). See docs/DEPLOYMENT.md before changing.
EMBEDDING_DIMENSIONS=1536

# --- Database (required). Local Docker example from docs/DEPLOYMENT.md ---
DATABASE_URL=postgresql://portfolio:devpass@localhost:5433/portfolio

# --- HTTP ---
ENVIRONMENT=development
# Comma-separated explicit origins. No wildcard in production.
ALLOWED_ORIGINS=http://localhost:5173
# Set true on Railway so the real client IP is read from X-Forwarded-For for rate limiting.
TRUST_PROXY_HEADERS=false

# --- Abuse and cost controls ---
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=150
MAX_MESSAGE_CHARS=600
MAX_HISTORY_MESSAGES=6

# --- Retrieval (tune against scripts/eval_rag.py output) ---
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.30
RETRIEVAL_STRONG_SCORE=0.45
MAX_CONTEXT_CHARS=6000

# --- Contact form (messages are stored in the DATABASE_URL PostgreSQL database, table contact_messages) ---
CONTACT_RATE_LIMIT_PER_HOUR=5

# Public, browser-visible configuration only. NEVER put OPENAI_API_KEY or any secret here.
# Base URL of the FastAPI backend (no trailing slash). Local default shown.
VITE_API_BASE_URL=http://localhost:8000

# Optional, used at build time to generate sitemap.xml / robots.txt (e.g. https://vasugadde.com).
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically when this is unset.
SITE_URL=
